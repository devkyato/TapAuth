AIRHUB_ENV=local
AIRHUB_STORAGE=mysql

AIRHUB_WIFI_SSID=your_wifi_ssid
AIRHUB_WIFI_PASSWORD=your_wifi_password

AIRHUB_DB_HOST=localhost
AIRHUB_DB_USER=your_mysql_user
AIRHUB_DB_PASSWORD=your_mysql_password
AIRHUB_DB_NAME=airhub_db

AIRHUB_FIREBASE_ENABLED=false
AIRHUB_FIREBASE_MODE=realtime_db
AIRHUB_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
AIRHUB_FIREBASE_PROJECT_ID=your_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json