AIRHUB_ENV=local
AIRHUB_DEBUG=false
AIRHUB_STORAGE=sqlite
TAPAUTH_ADMIN_CODE=replace-with-a-private-admin-code
TAPAUTH_GIT_BRANCH=main
TAPAUTH_REGISTRY_PATH=
TAPAUTH_SQLITE_PATH=

AIRHUB_WIFI_SSID=
AIRHUB_WIFI_PASSWORD=

AIRHUB_DB_HOST=localhost
AIRHUB_DB_USER=airhub_app
AIRHUB_DB_PASSWORD=replace-with-a-strong-password
AIRHUB_DB_NAME=airhub_db

AIRHUB_FIREBASE_PROJECT_ID=airhub-login

TAPAUTH_SUPABASE_ENABLED=false
TAPAUTH_SUPABASE_URL=
TAPAUTH_SUPABASE_SECRET_KEY=
TAPAUTH_SUPABASE_PUBLISHABLE_KEY=
TAPAUTH_DEVICE_ID=airhub-pi
TAPAUTH_BUCKET_ID=airhub
TAPAUTH_WEBHOOK_TARGETS=[]

# Secure Raspberry Pi to Vercel bridge (planned integration)
AIRHUB_DEVICE_ID=airhub-kiosk-01
AIRHUB_DEVICE_SECRET=replace-with-a-long-random-secret
SOE_API_BASE_URL=
